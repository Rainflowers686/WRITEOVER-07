flowchart TD
    A["读取 wo07 文件"] --> B{"头部 节数 长度 CRC 合法"}
    B -- 否 --> Reject["报告失败 保留运行态"]
    B -- 是 --> C["解析到临时 Player World AI 等状态"]
    C --> D{"数值 枚举 尾部 实体 房间合法"}
    D -- 否 --> Reject
    D -- 是 --> E["保存当前运行态快照"]
    E --> F["按依赖顺序提交房间与各模块"]
    F --> G{"任一提交阶段失败"}
    G -- 是 --> R["恢复快照并验证回滚"]
    R --> Reject
    G -- 否 --> H["清除未来的暂态提示与菜单缓存"]
    H --> Done["恢复游戏"]
    S["保存请求"] --> S1["序列化七节并写临时文件"]
    S1 --> S2{"临时文件写成功"}
    S2 -- 否 --> SF["报告失败 旧文件保留"]
    S2 -- 是 --> S3["原子替换目标文件 不预删除"]
    S3 --> S4{"替换成功"}
    S4 -- 否 --> SF
    S4 -- 是 --> S5["此槽位成功 最近恢复文件另行写入"]
