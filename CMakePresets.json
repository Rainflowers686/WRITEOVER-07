{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20 },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (VS2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/debug",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL",
        "WO_ENABLE_DEV": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (VS2022, /MT static)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/release",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "OFF"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (VS2022, matches windows-2022 runner)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/ci",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL",
        "WO_ENABLE_DEV": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Debug (Linux x64, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "WO_ENABLE_DEV": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Release (Linux x64, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "OFF"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Debug (Linux x64, Clang/Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "WO_ENABLE_DEV": "ON"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "Debug (macOS arm64, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "WO_ENABLE_DEV": "ON"
      }
    },
    {
      "name": "linux-arm64-link",
      "displayName": "Link (Linux arm64 cross compile)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-arm64-link",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "WO_BUILD_TESTS": "OFF",
        "WO_BUILD_TOOLS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "debug",   "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "ci",      "configurePreset": "ci",      "configuration": "Debug" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-clang", "configurePreset": "linux-clang" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "linux-arm64-link", "configurePreset": "linux-arm64-link" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "output": { "outputOnFailure": true }
    }
  ]
}
